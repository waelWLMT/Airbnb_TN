{
    "Notes": {
        "Jwt": "Secret fort prod. Utiliser variable d'environnement JWT_SECRET.",
        "Routes": "Routes publiques : RegisterUser, LoginUser, RefreshToken. Toutes les autres nécessitent JWT."
    },
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "Jwt": {
        "Key": "Ekcsu4hOdsaWbgy86TnNVRvHGDv3MZUj9HQYDnHAq2PtgYUTCRhjyEm3HCVvhZ2v7B0F2bg9BsIh8KlstOpQ+Q==",
        "Issuer": "AuthManagementSystem",
        "Audience": "gateway_api",
        "DurationInMinutes": 60,
        "RefreshTokenExpirationDays": 7
    },
    "AllowedHosts": "*",
    "ReverseProxy": {
        "PublicRoutes": {
            "RegisterUserRoute": {
                "ClusterId": "UserManagementCluster",
                "Match": { "Path": "/api/usersMgmt/users/CreateUser" },
                "Metadata": { "AllowAnonymous": "true" },
                "Transforms": [
                    { "PathRemovePrefix": "/api/usersMgmt" },
                    { "PathPrefix": "/api/" }
                ]
            },
            "LoginUserRoute": {
                "ClusterId": "authManagementCluster",
                "Match": { "Path": "/api/authMgmt/Authentications/login" },
                "Metadata": { "AllowAnonymous": "true" },
                "Transforms": [
                    { "PathRemovePrefix": "/api/authMgmt" },
                    { "PathPrefix": "/api/" }
                ]
            },
            "RefreshTokenRoute": {
                "ClusterId": "authManagementCluster",
                "Match": { "Path": "/api/authMgmt/Authentications/RefreshToken" },
                "Metadata": { "AllowAnonymous": "true" },
                "Transforms": [
                    { "PathRemovePrefix": "/api/authMgmt" },
                    { "PathPrefix": "/api/" }
                ]
            }
        },
        "ProtectedRoutes": {
            "UserManagementRoute": {
                "ClusterId": "UserManagementCluster",
                "Match": { "Path": "/api/usersMgmt/{**catch-all}" },
                "AuthorizationPolicy": "AuthenticatedUser",
                "Transforms": [
                    { "PathRemovePrefix": "/api/usersMgmt" },
                    { "PathPrefix": "/api/" }
                ]
            },
            "authManagementRoute": {
                "ClusterId": "authManagementCluster",
                "Match": { "Path": "/api/authMgmt/{**catch-all}" },
                "AuthorizationPolicy": "AuthenticatedUser",
                "Transforms": [
                    { "PathRemovePrefix": "/api/authMgmt" },
                    { "PathPrefix": "/api/" }
                ]
            },
            "bookingRoute": {
                "ClusterId": "bookingCluster",
                "Match": { "Path": "/api/bookings/{**catch-all}" },
                "AuthorizationPolicy": "AuthenticatedUser",
                "Transforms": [
                    { "PathRemovePrefix": "/api/bookings" }
                ]
            },
            "paymentRoute": {
                "ClusterId": "paymentCluster",
                "Match": { "Path": "/api/payments/{**catch-all}" },
                "AuthorizationPolicy": "AuthenticatedUser"
            },
            "reviewRoute": {
                "ClusterId": "reviewCluster",
                "Match": { "Path": "/api/reviews/{**catch-all}" },
                "AuthorizationPolicy": "AuthenticatedUser"
            },
            "reportRoute": {
                "ClusterId": "reportCluster",
                "Match": { "Path": "/api/reports/{**catch-all}" },
                "AuthorizationPolicy": "AuthenticatedUser"
            }
        },
        "Clusters": {
            "UserManagementCluster": {
                "LoadBalancingPolicy": "RoundRobin",
                "Destinations": { "userService": { "Address": "https://prod.userservice.com/" } },
                "Metadata": {
                    "HealthCheckEnabled": "true",
                    "HealthCheckInterval": "00:00:10",
                    "RetryCount": "3",
                    "RetryInterval": "00:00:02"
                }
            },
            "authManagementCluster": {
                "LoadBalancingPolicy": "RoundRobin",
                "Destinations": { "authService1": { "Address": "https://prod.authservice.com/" } },
                "Metadata": {
                    "HealthCheckEnabled": "true",
                    "HealthCheckInterval": "00:00:10",
                    "RetryCount": "3",
                    "RetryInterval": "00:00:02"
                }
            },
            "bookingCluster": {
                "Destinations": { "bookingService1": { "Address": "https://prod.bookingservice.com/" } }
            },
            "paymentCluster": {
                "LoadBalancingPolicy": "RoundRobin",
                "Destinations": { "paymentService": { "Address": "https://prod.paymentservice.com/" } }
            },
            "reviewCluster": {
                "LoadBalancingPolicy": "RoundRobin",
                "Destinations": { "reviewService": { "Address": "https://prod.reviewservice.com/" } }
            },
            "reportCluster": {
                "LoadBalancingPolicy": "RoundRobin",
                "Destinations": { "reportService": { "Address": "https://prod.reportservice.com/" } }
            }
        }
    }
}
